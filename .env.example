NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://hiveflow:hiveflow@localhost:5432/hiveflow
POSTGRES_USER=hiveflow
POSTGRES_PASSWORD=hiveflow
POSTGRES_DB=hiveflow
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=hiveflow
MINIO_ROOT_PASSWORD=hiveflow-local-password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hiveflow
S3_SECRET_KEY=hiveflow-local-password
S3_BUCKET=hiveflow-assets
IMAGE_PROVIDER=mock
DEFAULT_IMAGE_MODEL=mock-image
DEFAULT_LLM_MODEL=mock-llm
DEFAULT_TTS_MODEL=mock-tts
DEFAULT_VIDEO_MODEL=mock-video
PROVIDER_MAX_RETRIES=2
PROVIDER_CONCURRENCY_MOCK=2
KIND_CONCURRENCY_IMAGE=6
KIND_CONCURRENCY_LLM=6
KIND_CONCURRENCY_TTS=6
KIND_CONCURRENCY_VIDEO=2
MAX_AUDIO_MB=25
MAX_VIDEO_MB=250
MOCK_FAILURE_RATE=0
MAX_UPLOAD_MB=20
PROVIDER_TIMEOUT_MS=120000
RUN_RECOVERY_TIMEOUT_MS=930000
SPACE_RUN_CONCURRENCY=3
WORKER_CONCURRENCY=6

IMAGE_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=120000
TTS_TIMEOUT_MS=120000
VIDEO_TIMEOUT_MS=900000
VIDEO_WORKER_CONCURRENCY=2
PROVIDER_CONCURRENCY_MOCK_VIDEO=2

MAX_BATCH_PROVIDER_NODES=100
MAX_BATCH_UNITS=1000
DAILY_UNITS_LIMIT=10000

# OpenRouter is optional; defaults remain mock models. Never commit keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=
PROVIDER_CONCURRENCY_OPENROUTER=
# Manual CLI only. Set to 1 explicitly for a billable live check.
HIVEFLOW_LIVE_CHECK=
